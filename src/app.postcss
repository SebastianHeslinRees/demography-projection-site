/* Write your global styles here, in PostCSS syntax */
@import '@ldn-viz/themes/styles/primitives.css';
@import '@ldn-viz/themes/styles/primitive-scale.css';
@import '@ldn-viz/themes/styles/light.css';
@import '@ldn-viz/themes/styles/dark.css';
@import '@ldn-viz/themes/styles/spacing.css';
@import '@ldn-viz/themes/styles/typography.css';
@import '@ldn-viz/themes/styles/flow.css';
@import '@ldn-viz/themes/styles/grid-spacing.css';
@import '@ldn-viz/themes/styles/shadows.css';

@tailwind base;
@tailwind components;
@tailwind utilities;

html {
	scroll-behavior: smooth;
}

html.disable-smooth-scroll {
	scroll-behavior: auto;
}

[id] {
	scroll-margin-top: 66px;
}

@layer components {
	/*.tooltip p {
        @apply prose !body-sm responsive;
    }

    .footnotes-section p {
        @apply prose !body-xs responsive;
    }*/

	.footnotes-section .data-footnote-backref {
		@apply inline-flex;
	}

	.ldn-viz-sidebar-toggle {
		@apply hidden;
	}

	table {
		border-collapse: collapse;
		width: 100%;
	}

	tbody tr:nth-child(even) td {
		background-color: var(--color-canvas-muted);
	}

	thead tr th {
		text-align: left;
	}

	/* MB-Note: added override to adjust margin-top of H2s that start content */
	/* .prose :where(h2):where(:first-child) {
        margin-top: 24px;
    }
    .prose :where(h3):where(:first-child) {
        margin-top: 24px;
    } */

	/* Rotate choropleth legend tick labels only (not hover text or other chart text) */
	.map-legend-rotated .themed-chart svg.defaultColorLegendLabel-ramp g.tick text {
		transform-box: fill-box;
		transform-origin: center;
		transform: rotate(45deg);
	}
}
